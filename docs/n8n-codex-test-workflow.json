{
  "name": "Codex Test Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "codex-test",
        "responseMode": "responseNode",
        "options": {
          "responseData": "firstEntryJson",
          "allowedOrigins": "*",
          "rawBody": false
        }
      },
      "name": "Webhook Entrada",
