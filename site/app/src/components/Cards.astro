---
const { items = [], class: className } = Astro.props;
---

<div class:list={["cards", className]}>
  <div class="cards__grid cards-grid">
    {items.map((item) => (
      <article class="card cards__card">
        <h3 class="card__title">{item.title}</h3>
        {item.subtitle && <p class="cards__subtitle">{item.subtitle}</p>}
        {item.items?.length ? (
          <ul class="cards__list">
            {item.items.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        ) : null}
      </article>
    ))}
  </div>
</div>

<style>
  /* Usa grid responsivo para reducir scroll en entregables. */
.cards__grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }

  /* Ordena el contenido interno de cada tarjeta. */
  .cards__card {
    display: grid;
    gap: var(--s-12);
  }

  /* Evita saltos en títulos de tarjetas. */
  .cards__card h3 {
    margin-top: 0;
  }

  /* Mejora la lectura del subtítulo con tono suave. */
  .cards__subtitle {
    margin: 0 0 var(--s-16);
    color: var(--muted);
    line-height: 1.6;
  }

  /* Usa bullets con icono para mayor escaneo visual. */
  .cards__list {
    display: grid;
    gap: var(--s-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cards__list li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: var(--s-8);
    align-items: start;
  }

  .cards__list li::before {
    content: '✓';
    color: var(--accent);
    font-weight: var(--w-bold);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  /* Variante compacta para entregables con menos altura. */
  .cards--compact .cards__card {
    gap: var(--s-8);
  }

  .cards--compact .card__title {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  }

  .cards--compact .cards__subtitle,
  .cards--compact .cards__list li {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Fuerza una columna en móviles para evitar cortes. */
  @media (min-width: 768px) {
    .cards__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .cards__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
