---
const {
  title = 'Coordinar una reunión',
  description = 'Contanos tu necesidad y te proponemos un plan de trabajo.',
  href = '/contacto',
  buttonText = 'Coordinar una reunión',
  class: className,
} = Astro.props;
---

<section class:list={["cta-block", className]}>
  <div class="cta-block__content">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <a class="cta-block__button" href={href}>{buttonText}</a>
</section>

<style>
  .cta-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
    border-radius: 18px;
    border-left: 4px solid #8bcb3c;
    background: #f8f6f2;
    box-shadow: 0 10px 28px rgba(47, 47, 47, 0.08);
  }

  .cta-block__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cta-block__content h3 {
    margin: 0;
    color: #2f2f2f;
  }

  .cta-block__content p {
    margin: 0;
    color: #8c8c8c;
  }

  .cta-block__button {
    align-self: flex-start;
    background: #8bcb3c;
    color: #2f2f2f;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cta-block__button:hover {
    background: #5e9f2e;
    transform: translateY(-2px);
  }

  .cta-block__button:focus-visible,
  .cta-block a:focus-visible {
    outline: 2px solid #5e9f2e;
    outline-offset: 3px;
  }

  .cta-block--footer {
    background: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-block__button {
      transition: none;
    }

    .cta-block__button:hover {
      transform: none;
    }
  }
</style>
