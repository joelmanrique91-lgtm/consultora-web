---
import { Image } from 'astro:assets';
import { withBase } from '../utils/links';
import { withBaseUrl } from '../utils/paths';

const {
  title,
  subtitle,
  ctaHref = withBase('/contacto'),
  ctaLabel = 'Coordinar una reunión',
  secondaryCtaHref = null,
  secondaryCtaLabel = '',
  backgroundSrc = null,
  backgroundAlt = '',
} = Astro.props;
const resolvedCtaHref = withBase(ctaHref);
const resolvedSecondaryHref = secondaryCtaHref ? withBase(secondaryCtaHref) : null;
const backgroundData =
  typeof backgroundSrc === 'string'
    ? { src: backgroundSrc }
    : backgroundSrc && typeof backgroundSrc === 'object'
      ? backgroundSrc
      : null;
const backgroundSrcValue = backgroundData?.src ?? backgroundData?.href ?? null;
const resolvedBackgroundSrc =
  typeof backgroundSrcValue === 'string' ? withBaseUrl(backgroundSrcValue) : backgroundSrcValue;
const backgroundWidth = backgroundData?.width;
const backgroundHeight = backgroundData?.height;
const shouldOptimizeImage = Boolean(
  backgroundData &&
    typeof backgroundData === 'object' &&
    'src' in backgroundData &&
    backgroundData.width &&
    backgroundData.height
);
---

<section class="hero section">
  <div class="container">
    <div class="hero__content reading stack-lg">
      <div class="stack">
        <h1>{title}</h1>
        <p class="hero__subtitle">{subtitle}</p>
      </div>
      <div class="hero__actions">
        <a class="btn-primary" href={resolvedCtaHref}>{ctaLabel}</a>
        {resolvedSecondaryHref && secondaryCtaLabel && (
          <a class="btn-secondary" href={resolvedSecondaryHref}>
            {secondaryCtaLabel}
          </a>
        )}
      </div>
    </div>
    {resolvedBackgroundSrc && (
      <div class="hero__visual" aria-hidden={backgroundAlt ? undefined : 'true'}>
        {shouldOptimizeImage ? (
          <Image
            src={backgroundData}
            alt={backgroundAlt}
            widths={[360, 480, 640, 840]}
            sizes="(min-width: 900px) 420px, 100vw"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        ) : (
          <img
            src={resolvedBackgroundSrc}
            alt={backgroundAlt}
            width={backgroundWidth}
            height={backgroundHeight}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        )}
      </div>
    )}
  </div>
</section>

<style>
  /* Refuerza el hero con fondo suave y padding amplio. */
  .hero {
    background: linear-gradient(120deg, rgba(218, 243, 185, 0.55), rgba(249, 244, 237, 0.3));
    border-bottom: 1px solid rgba(125, 95, 70, 0.15);
    padding-block: clamp(56px, 8vw, 104px);
  }

  /* Ajusta la separación entre título y CTA. */
  .hero__content {
    gap: var(--s-32);
    max-width: var(--reading-ch);
  }

  /* Ordena el hero en grid para mejor jerarquía visual. */
  .hero .container {
    display: grid;
    gap: var(--s-32);
  }

  /* Mejora la legibilidad del subtítulo con tamaño responsivo. */
  .hero__subtitle {
    margin: 0;
    color: var(--muted);
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.6;
  }

  /* Asegura CTAs visibles y alineados. */
  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--s-12);
    flex-wrap: wrap;
  }

  /* Centra el visual para balancear el layout. */
  .hero__visual {
    align-self: center;
    display: flex;
    justify-content: center;
  }

  /* Aporta profundidad y orden al asset visual. */
  .hero__visual img {
    width: min(420px, 100%);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--earth-soft);
    box-shadow: 0 16px 28px rgba(47, 47, 47, 0.08);
  }

  /* Pasa a dos columnas en desktop para reducir scroll. */
  @media (min-width: 900px) {
    .hero .container {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
    }
  }

  @media (max-width: 600px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .btn-primary,
    .hero__actions .btn-secondary {
      width: 100%;
    }
  }
</style>
