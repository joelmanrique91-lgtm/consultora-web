---
const {
  title,
  subtitle,
  ctaHref = '/contacto',
  ctaLabel = 'Coordinar una reunión',
  backgroundSrc = null,
  backgroundAlt = '',
} = Astro.props;
---

<section class="hero section">
  <div class="container">
    <div class="hero__content reading stack-lg">
      <div class="stack">
        <h1>{title}</h1>
        <p class="hero__subtitle">{subtitle}</p>
      </div>
      <div class="hero__actions">
        <a class="btn-primary" href={ctaHref}>{ctaLabel}</a>
      </div>
    </div>
    {backgroundSrc && (
      <div class="hero__visual" aria-hidden={backgroundAlt ? undefined : 'true'}>
        <img src={backgroundSrc} alt={backgroundAlt} loading="lazy" />
      </div>
    )}
  </div>
</section>

<style>
  .hero__content {
    gap: var(--s-32);
    max-width: 560px;
  }

  .hero .container {
    display: grid;
    gap: var(--s-32);
  }

  .hero__subtitle {
    margin: 0;
    color: var(--muted);
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--s-12);
    flex-wrap: wrap;
  }

  .hero__visual {
    align-self: center;
    display: flex;
    justify-content: center;
  }

  .hero__visual img {
    width: min(420px, 100%);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--earth-soft);
    box-shadow: 0 16px 28px rgba(47, 47, 47, 0.08);
  }

  @media (min-width: 900px) {
    .hero .container {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
    }
  }
</style>
