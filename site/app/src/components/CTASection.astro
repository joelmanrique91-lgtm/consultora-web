---
import { withBase } from '../utils/links';

const {
  title,
  text,
  ctaHref = withBase('/contacto'),
  ctaLabel = 'Coordinar una reunión',
  class: className,
} = Astro.props;
const resolvedCtaHref = withBase(ctaHref);
---

<section class:list={["cta-section", className]}>
  <div class="cta-section__content">
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <a class="btn-primary" href={resolvedCtaHref}>{ctaLabel}</a>
</section>

<style>
  .cta-section {
    display: flex;
    flex-direction: column;
    gap: var(--s-20);
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius);
    background: var(--earth-soft);
    border: 1px solid var(--border);
  }

  .cta-section__content {
    display: grid;
    gap: var(--s-12);
  }

  .cta-section__content h2 {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 30px);
  }

  .cta-section__content p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
    max-width: 58ch;
  }

  @media (min-width: 900px) {
    .cta-section {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
