---
const { text, variant = 'default', class: className } = Astro.props;
---

<aside class:list={["callout", `callout--${variant}`, className]}>
  <p>{text}</p>
</aside>

<style>
  .callout {
    border: 1px solid rgba(47, 47, 47, 0.1);
    border-left: 3px solid rgba(47, 47, 47, 0.2);
    background: rgba(249, 246, 240, 0.7);
    border-radius: var(--radius);
    padding: clamp(16px, 2vw, 22px);
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: var(--w-regular);
    font-size: 0.98rem;
    color: var(--earth);
    margin: 0;
  }

  .callout p {
    margin: 0;
    line-height: 1.6;
  }

  .callout--soft {
    background: var(--earth-soft);
  }
</style>
