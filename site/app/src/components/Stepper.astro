---
const { items = [], class: className } = Astro.props;
---

<ol class:list={["stepper", className]}>
  {items.map((item) => (
    <li class="stepper__item">
      <span class="stepper__num">{item.num}</span>
      <div class="stepper__body">
        <h3>{item.title}</h3>
        <p>{item.desc}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  /* Ordena el proceso en tarjetas con separación clara. */
  .stepper {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--card-gap);
  }

  /* Destaca cada etapa con un separador sutil. */
  .stepper__item {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--s-16);
    row-gap: var(--s-6);
    align-items: start;
    padding: var(--s-16) 0;
    border-bottom: 1px solid rgba(47, 47, 47, 0.12);
  }

  .stepper__item:first-child {
    padding-top: 0;
  }

  .stepper__item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  /* Mejora la jerarquía numérica con un badge visible. */
  .stepper__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--earth);
    font-weight: var(--w-semibold);
    font-size: var(--text-small);
  }

  /* Reduce el espacio superior para títulos compactos. */
  .stepper__body h3 {
    margin: 0 0 var(--s-6);
  }

  /* Mantiene descripción legible y secundaria. */
  .stepper__body p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  /* Usa 2 columnas en tablet/desktop para acortar scroll. */
  @media (min-width: 768px) {
    .stepper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
