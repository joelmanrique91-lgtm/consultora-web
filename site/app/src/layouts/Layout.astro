---
import { site } from '../data/site';
import logotype from '../assets/brand/pistacho_logotype.jpg';
import illustration from '../assets/brand/pistacho_illustration.jpg';
import '../styles/tokens.css';
import '../styles/global.css';

const { pathname } = Astro.url;
const isActive = (href) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Consultora</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container header__inner">
        <a class="header__brand" href="/" aria-label="Consultora">
          <img src={logotype} alt="Consultora" width="160" height="48" />
        </a>
        <nav class="site-nav">
          <a class={`nav__link${isActive('/') ? ' is-active' : ''}`} href="/"
            >Home</a
          >
          <a
            class={`nav__link${isActive('/servicios') ? ' is-active' : ''}`}
            href="/servicios"
            >Servicios</a
          >
          <a
            class={`nav__link${isActive('/sobre') ? ' is-active' : ''}`}
            href="/sobre"
            >Sobre</a
          >
          <a
            class={`nav__link${isActive('/experiencia') ? ' is-active' : ''}`}
            href="/experiencia"
            >Experiencia</a
          >
          <a
            class={`nav__link${isActive('/posts') ? ' is-active' : ''}`}
            href="/posts"
            >Posts</a
          >
          <a
            class={`nav__link${isActive('/contacto') ? ' is-active' : ''}`}
            href="/contacto"
            >Contacto</a
          >
        </nav>
        <a class="btn-primary" href="/contacto" aria-label="Coordinar una reunión">
          Coordinar una reunión
        </a>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer__content">
        <p class="footer__brand">{site.footer.name}</p>
        <p class="footer__positioning">{site.footer.positioning}</p>
        <div class="footer__details">
          <a href={`mailto:${site.footer.email}`}>{site.footer.email}</a>
          <span>{site.footer.location}</span>
          {site.footer.linkedin && (
            <a
              href={site.footer.linkedin}
              rel="noopener noreferrer"
              target="_blank"
            >
              LinkedIn
            </a>
          )}
        </div>
        <img src={illustration} alt="Pistacho illustration" />
      </div>
      <p>© Consultora — Todos los derechos reservados</p>
    </footer>
    <a class="btn-primary cta-mobile" href="/contacto" aria-label="Coordinar una reunión">
      Coordinar una reunión
    </a>
    <script is:inline>
      const header = document.querySelector('.site-header');

      if (header) {
        const hideThreshold = 10;
        const topOffset = 24;
        let lastScrollY = window.scrollY;
        let lastToggleY = lastScrollY;

        const updateHeaderState = () => {
          const currentScrollY = window.scrollY;
          const isScrollingDown = currentScrollY > lastScrollY + 2;
          const isScrollingUp = currentScrollY < lastScrollY - 2;

          if (
            isScrollingDown &&
            currentScrollY > topOffset &&
            currentScrollY - lastToggleY > hideThreshold
          ) {
            header.classList.add('is-hidden');
            lastToggleY = currentScrollY;
          } else if (
            (isScrollingUp && lastToggleY - currentScrollY > hideThreshold) ||
            currentScrollY <= topOffset
          ) {
            header.classList.remove('is-hidden');
            lastToggleY = currentScrollY;
          }

          header.classList.toggle('is-scrolled', currentScrollY > 10);
          lastScrollY = currentScrollY;
        };

        updateHeaderState();
        window.addEventListener('scroll', updateHeaderState, { passive: true });
      }
    </script>
  </body>
</html>
