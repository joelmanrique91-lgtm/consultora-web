---
const { pathname } = Astro.url;
const isActive = (href) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Consultora</title>
  </head>

  <body>
    <header class="site-header">
      <nav>
        <a class={`nav__link${isActive("/") ? " is-active" : ""}`} href="/"
          >Home</a
        > |
        <a
          class={`nav__link${isActive("/servicios") ? " is-active" : ""}`}
          href="/servicios"
          >Servicios</a
        > |
        <a class={`nav__link${isActive("/sobre") ? " is-active" : ""}`} href="/sobre"
          >Sobre</a
        > |
        <a
          class={`nav__link${isActive("/experiencia") ? " is-active" : ""}`}
          href="/experiencia"
          >Experiencia</a
        > |
        <a class={`nav__link${isActive("/posts") ? " is-active" : ""}`} href="/posts"
          >Posts</a
        > |
        <a
          class={`nav__link${isActive("/contacto") ? " is-active" : ""}`}
          href="/contacto"
          >Contacto</a
        >
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>© Consultora — Todos los derechos reservados</p>
    </footer>
  </body>
</html>
<style>
  :root {
    --max-width: 900px;
    --bg: #faf7f1;
    --surface: #ffffff;
    --border: #e6e6e6;
    --text: #2f2f2f;
    --muted: #8c8c8c;
    --accent: #8bcb3c;
    --accent-hover: #5e9f2e;
    --accent-soft: #cff2a3;
    --earth: #8a6b4f;
    --earth-soft: #e8ddcf;
    --earth-mid: #cbb59a;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      Roboto, Ubuntu, Cantarell, "Helvetica Neue", Arial, sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
  }

  header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: box-shadow 0.2s ease;
  }

  header.is-scrolled {
    box-shadow: 0 6px 16px rgba(47, 47, 47, 0.08);
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    gap: 1rem;
  }

  a {
    color: var(--text);
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--accent-hover);
  }

  .nav__link {
    position: relative;
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: color 0.2s ease, background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav__link:hover {
    color: var(--accent-hover);
  }

  .nav__link::after {
    content: "";
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.2rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  .nav__link.is-active {
    color: var(--text);
    background-color: var(--accent-soft);
    border-color: var(--accent);
  }

  .nav__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  main {
    max-width: var(--max-width);
    margin: 2rem auto;
    padding: 0 1rem;
    width: 100%;
  }

  h1 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  h2 {
    margin-top: 2rem;
    font-size: 1.4rem;
    color: var(--earth);
  }

  section {
    margin-top: 2rem;
  }

  ul {
    padding-left: 1.2rem;
  }

  ul li::marker {
    color: var(--accent);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.2s ease, color 0.2s ease,
      border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .btn--primary {
    background: var(--accent);
    color: var(--text);
    box-shadow: 0 6px 14px rgba(94, 159, 46, 0.18);
  }

  .btn--primary:hover {
    background: var(--accent-hover);
    color: var(--text);
  }

  .btn--secondary {
    background: transparent;
    color: var(--text);
    border-color: var(--accent);
  }

  .btn--secondary:hover {
    background: var(--accent-soft);
  }

  footer {
    margin-top: 4rem;
    padding: 2rem 1rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--earth);
    border-top: 1px solid var(--border);
    background: var(--earth-soft);
  }

  footer a {
    color: var(--earth);
  }

  footer a:hover {
    color: var(--accent-hover);
  }

  @media (max-width: 768px) {
    main {
      margin: 1.5rem auto;
      padding-inline: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header,
    .nav__link,
    .nav__link::after,
    .btn {
      transition: none;
    }

    .nav__link::after {
      transform: none;
    }
  }
</style>

<script>
  const header = document.querySelector("header");

  if (header) {
    const toggleHeaderShadow = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 10);
    };

    toggleHeaderShadow();
    window.addEventListener("scroll", toggleHeaderShadow, { passive: true });
  }
</script>
