---
import { site } from '../data/site';
import { assertStringAttr, withBase } from '../utils/links';
import { getBaseUrl, withBaseUrl } from '../utils/paths';
import logotype from '../assets/brand/pistacho_logotype.jpg';
import illustration from '../assets/brand/pistacho_illustration.jpg';
import '../styles/tokens.css';
import '../styles/global.css';

const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL ?? '/';
const baseUrl = getBaseUrl();
const isDev = import.meta.env.DEV;
const faviconHref = withBaseUrl('/favicon.svg', 'Layout.favicon');
const footerEmail = assertStringAttr('href', site.footer.email, 'footer email') ?? '';
const footerLinkedin = site.footer.linkedin
  ? assertStringAttr('href', site.footer.linkedin, 'footer linkedin')
  : null;
const normalizePath = (href) => {
  const normalized = href.endsWith('/') && href.length > 1 ? href.slice(0, -1) : href;
  return normalized;
};
const currentPath = normalizePath(pathname);
const isActive = (href) => {
  const resolvedHref = normalizePath(withBase(href));
  const normalizedBase = normalizePath(base);

  if (resolvedHref === normalizedBase) {
    return currentPath === normalizedBase;
  }

  return currentPath.startsWith(resolvedHref);
};
const isExternalLink = (href) => typeof href === 'string' && href.length > 0;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Consultora</title>
    <link rel="icon" href={faviconHref} />
  </head>

  <body>
    <header class="site-header">
      <div class="container header__inner">
        <a class="header__brand" href={withBase('/')} aria-label="Consultora">
          <img src={withBaseUrl(logotype.src)} alt="Consultora" width="160" height="48" />
        </a>
        <details class="site-nav__details">
          <summary
            class="header__toggle"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="site-nav-panel"
          >
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <div class="site-nav__panel" id="site-nav-panel">
            <nav class="site-nav" aria-label="Principal">
              <a
                class={`nav__link${isActive('/') ? ' is-active' : ''}`}
                href={withBase('/')}
              >
                Home</a
              >
              <a
                class={`nav__link${isActive('/servicios') ? ' is-active' : ''}`}
                href={withBase('/servicios')}
                >Servicios</a
              >
              <a
                class={`nav__link${isActive('/sobre') ? ' is-active' : ''}`}
                href={withBase('/sobre')}
                >Sobre</a
              >
              <a
                class={`nav__link${isActive('/experiencia') ? ' is-active' : ''}`}
                href={withBase('/experiencia')}
                >Experiencia</a
              >
              <a
                class={`nav__link${isActive('/posts') ? ' is-active' : ''}`}
                href={withBase('/posts')}
                >Posts</a
              >
              <a
                class={`nav__link${isActive('/contacto') ? ' is-active' : ''}`}
                href={withBase('/contacto')}
                >Contacto</a
              >
            </nav>
            <a
              class="btn-primary site-nav__cta"
              href={withBase('/contacto')}
              aria-label="Coordinar una reunión"
            >
              Coordinar una reunión
            </a>
          </div>
        </details>
        <div class="site-nav__backdrop" aria-hidden="true"></div>
      </div>
    </header>

    <div class="page-content" id="page-content">
      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container footer__content">
          <p class="footer__brand">{site.footer.name}</p>
          <p class="footer__positioning">{site.footer.positioning}</p>
          <div class="footer__details">
            <a href={`mailto:${footerEmail}`}>{footerEmail}</a>
            <span>{site.footer.location}</span>
            {isExternalLink(footerLinkedin) && (
              <a
                href={footerLinkedin}
                rel="noopener noreferrer"
                target="_blank"
              >
                LinkedIn
              </a>
            )}
          </div>
          <img
            src={withBaseUrl(illustration.src)}
            alt="Pistacho illustration"
            width={illustration.width}
            height={illustration.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <p>© Consultora — Todos los derechos reservados</p>
      </footer>
      <a
        class="btn-primary cta-mobile"
        href={withBase('/contacto')}
        aria-label="Coordinar una reunión"
      >
        Coordinar una reunión
      </a>
    </div>
    {isDev && (
      <script is:inline>
        {`(() => {
          const base = ${JSON.stringify(baseUrl)};
          if (!base || base === '/') {
            return;
          }

          const isUnsafeAbsolute = (value) =>
            value.startsWith('/') && !value.startsWith(base) && !value.startsWith('//');

          document.querySelectorAll('[src], [href]').forEach((node) => {
            if (!(node instanceof HTMLElement)) {
              return;
            }

            const src = node.getAttribute('src');
            if (src && isUnsafeAbsolute(src)) {
              console.warn('[base-url] src without base prefix:', {
                tag: node.tagName.toLowerCase(),
                value: src,
              });
            }

            const href = node.getAttribute('href');
            if (href && isUnsafeAbsolute(href)) {
              console.warn('[base-url] href without base prefix:', {
                tag: node.tagName.toLowerCase(),
                value: href,
              });
            }
          });
        })();`}
      </script>
    )}
    <script is:inline>
      const initHeader = () => {
        const header = document.querySelector('.site-header');
        if (!header || header.dataset.headerInit === 'true') {
          return;
        }

        header.dataset.headerInit = 'true';
        const hideThreshold = 10;
        const topOffset = 24;
        let lastScrollY = window.scrollY;
        let lastToggleY = lastScrollY;
        let ticking = false;

        const updateHeaderState = () => {
          const currentScrollY = window.scrollY;
          const isScrollingDown = currentScrollY > lastScrollY + 2;
          const isScrollingUp = currentScrollY < lastScrollY - 2;

          if (
            isScrollingDown &&
            currentScrollY > topOffset &&
            currentScrollY - lastToggleY > hideThreshold
          ) {
            header.classList.add('is-hidden');
            lastToggleY = currentScrollY;
          } else if (
            (isScrollingUp && lastToggleY - currentScrollY > hideThreshold) ||
            currentScrollY <= topOffset
          ) {
            header.classList.remove('is-hidden');
            lastToggleY = currentScrollY;
          }

          header.classList.toggle('is-scrolled', currentScrollY > 10);
          lastScrollY = currentScrollY;
          ticking = false;
        };

        const handleScroll = () => {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(updateHeaderState);
          }
        };

        updateHeaderState();
        window.addEventListener('scroll', handleScroll, { passive: true });
      };

      const initMenu = (root = document) => {
        const navDetails = root.querySelector('.site-nav__details');
        if (!navDetails) {
          return;
        }

        const navToggle = navDetails.querySelector('.header__toggle');
        const navPanel = navDetails.querySelector('.site-nav__panel');
        if (!navToggle || !navPanel) {
          return;
        }

        const navBackdrop = root.querySelector('.site-nav__backdrop');
        const pageContent = root.querySelector('#page-content');
        const supportsInert = 'inert' in HTMLElement.prototype;
        const isInitialized = navDetails.dataset.menuInit === 'true';

        const setPageInert = (isInert) => {
          if (!pageContent) {
            return;
          }

          if (isInert) {
            if (supportsInert) {
              pageContent.setAttribute('inert', '');
            }
            pageContent.setAttribute('aria-hidden', 'true');
            pageContent.classList.add('is-inert');
          } else {
            if (supportsInert) {
              pageContent.removeAttribute('inert');
            }
            pageContent.removeAttribute('aria-hidden');
            pageContent.classList.remove('is-inert');
          }
        };

        const mobileQuery = window.matchMedia('(max-width: 768px)');
        const addMediaListener = (query, handler) => {
          if (typeof query.addEventListener === 'function') {
            query.addEventListener('change', handler);
          } else if (typeof query.addListener === 'function') {
            query.addListener(handler);
          }
        };
        const syncMenuState = () => {
          const isMobile = mobileQuery.matches;
          if (!isMobile) {
            navDetails.setAttribute('open', '');
          }
          const isOpen = navDetails.hasAttribute('open');
          navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          navToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
          if (isMobile) {
            navPanel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
            if (supportsInert) {
              if (isOpen) {
                navPanel.removeAttribute('inert');
              } else {
                navPanel.setAttribute('inert', '');
              }
            }
            document.body.classList.toggle('menu-open', isOpen);
            setPageInert(isOpen);
          } else {
            navPanel.removeAttribute('aria-hidden');
            if (supportsInert) {
              navPanel.removeAttribute('inert');
            }
            document.body.classList.remove('menu-open');
            setPageInert(false);
          }

          if (isOpen && isMobile) {
            const firstLink = navPanel.querySelector('a');
            window.requestAnimationFrame(() => {
              firstLink?.focus();
            });
          }
        };

        const closeMenu = () => {
          if (!mobileQuery.matches) {
            return;
          }
          navDetails.removeAttribute('open');
          navToggle.focus();
        };

        if (!isInitialized) {
          navDetails.dataset.menuInit = 'true';
          navDetails.addEventListener('toggle', syncMenuState);
          addMediaListener(mobileQuery, syncMenuState);

          navBackdrop?.addEventListener('click', closeMenu);

          navPanel.addEventListener('click', (event) => {
            const target = event.target;
            const link = target instanceof Element ? target.closest('a') : null;
            if (link) {
              closeMenu();
            }
          });

          if (document.documentElement.dataset.menuKeydownInit !== 'true') {
            document.documentElement.dataset.menuKeydownInit = 'true';
            window.addEventListener('keydown', (event) => {
              const activeDetails = document.querySelector('.site-nav__details');
              const activePanel = activeDetails?.querySelector('.site-nav__panel');
              const activeToggle = activeDetails?.querySelector('.header__toggle');

              if (
                !activeDetails ||
                !activePanel ||
                !activeToggle ||
                !activeDetails.hasAttribute('open') ||
                !mobileQuery.matches
              ) {
                return;
              }

              if (event.key === 'Escape') {
                activeDetails.removeAttribute('open');
                activeToggle.focus();
                return;
              }

              if (event.key !== 'Tab') {
                return;
              }

              const focusableElements = Array.from(
                activePanel.querySelectorAll(
                  'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex=\"-1\"])'
                )
              ).filter((element) => !element.hasAttribute('disabled'));

              if (!focusableElements.length) {
                event.preventDefault();
                return;
              }

              const firstElement = focusableElements[0];
              const lastElement = focusableElements[focusableElements.length - 1];
              const isShiftPressed = event.shiftKey;
              const activeElement = document.activeElement;

              if (isShiftPressed && activeElement === firstElement) {
                event.preventDefault();
                lastElement.focus();
              } else if (!isShiftPressed && activeElement === lastElement) {
                event.preventDefault();
                firstElement.focus();
              } else if (!activePanel.contains(activeElement)) {
                event.preventDefault();
                firstElement.focus();
              }
            });
          }
        }

        syncMenuState();
      };

      const runInit = () => {
        initHeader();
        initMenu();
      };

      runInit();
      document.addEventListener('DOMContentLoaded', runInit);
      document.addEventListener('astro:page-load', runInit);
      window.addEventListener('pageshow', runInit);
    </script>
  </body>
</html>
