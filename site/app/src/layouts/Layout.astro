---
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/global.css';

const { pathname } = Astro.url;
const isActive = (href) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Consultora</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <div class="container header__inner">
        <nav class="site-nav">
          <a class={`nav__link${isActive('/') ? ' is-active' : ''}`} href="/"
            >Home</a
          >
          <a
            class={`nav__link${isActive('/servicios') ? ' is-active' : ''}`}
            href="/servicios"
            >Servicios</a
          >
          <a
            class={`nav__link${isActive('/sobre') ? ' is-active' : ''}`}
            href="/sobre"
            >Sobre</a
          >
          <a
            class={`nav__link${isActive('/experiencia') ? ' is-active' : ''}`}
            href="/experiencia"
            >Experiencia</a
          >
          <a
            class={`nav__link${isActive('/posts') ? ' is-active' : ''}`}
            href="/posts"
            >Posts</a
          >
          <a
            class={`nav__link${isActive('/contacto') ? ' is-active' : ''}`}
            href="/contacto"
            >Contacto</a
          >
        </nav>
        <a class="btn-primary" href="/contacto" aria-label="Coordinar una reunión">
          Coordinar una reunión
        </a>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer>
      <div class="container footer__content">
        <p class="footer__brand">{site.footer.name}</p>
        <p class="footer__positioning">{site.footer.positioning}</p>
        <div class="footer__details">
          <a href={`mailto:${site.footer.email}`}>{site.footer.email}</a>
          <span>{site.footer.location}</span>
          {site.footer.linkedin && (
            <a
              href={site.footer.linkedin}
              rel="noopener noreferrer"
              target="_blank"
            >
              LinkedIn
            </a>
          )}
        </div>
      </div>
      <p>© Consultora — Todos los derechos reservados</p>
    </footer>
    <a class="btn-primary cta-mobile" href="/contacto" aria-label="Coordinar una reunión">
      Coordinar una reunión
    </a>
  </body>
</html>

<script>
  const header = document.querySelector('.site-header');

  if (header) {
    const toggleHeaderShadow = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 10);
    };

    toggleHeaderShadow();
    window.addEventListener('scroll', toggleHeaderShadow, { passive: true });
  }
</script>
