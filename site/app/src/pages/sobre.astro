---
import Layout from '../layouts/Layout.astro';
import CtaBlock from '../components/CtaBlock.astro';
---

<Layout>
  <main>
    <h1>Sobre la consultora</h1>
    <p>
      Somos una consultora orientada a resolver problemas complejos con enfoque técnico,
      claridad operativa y resultados medibles.
    </p>

    <h2>Cómo trabajamos</h2>
    <ul>
      <li>Entendemos el contexto y el problema real</li>
      <li>Proponemos opciones con pros y contras</li>
      <li>Ejecutamos con trazabilidad y comunicación clara</li>
    </ul>

    <CtaBlock
      title="¿Querés ordenar tu comunicación?"
      description="Conversemos sobre el contexto y definamos un plan de trabajo claro."
      href="/contacto"
      buttonText="Coordinar una reunión"
    />
  </main>
</Layout>
