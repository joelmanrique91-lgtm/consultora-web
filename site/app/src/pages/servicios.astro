---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import { site } from '../data/site';
---

<Layout>
  <section class="section">
    <div class="container stack-lg">
      <header class="reading stack">
        <h1>{site.brand.tagline}</h1>
        <p>
          Consolidamos estrategia, planificación y acompañamiento para potenciar tu comunicación
          institucional.
        </p>
      </header>

      <div class="stack-lg">
        <h2>Servicios</h2>
        <div class="services-grid">
          {site.services.map((service) => (
            <article class="card service-card">
              <h3 class="card__title">{service.title}</h3>
              <p class="service-card__subtitle">{service.description}</p>
              <div class="service-card__section">
                <p class="service-card__label">Ideal para:</p>
                <ul>
                  {service.ideal.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div class="service-card__section">
                <p class="service-card__label">Cuándo conviene</p>
                <ul>
                  {service.whenItems.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>

      <CTASection
        title="¿Te identificás con alguno de estos escenarios?"
        text="Contanos tu necesidad y definimos el plan más adecuado para ordenar tu comunicación institucional."
        ctaHref={site.cta.href}
      />
    </div>
  </section>
</Layout>

<style>
  .services-grid {
    display: grid;
    gap: var(--card-gap);
    grid-template-columns: 1fr;
  }

  .service-card {
    display: grid;
    gap: var(--s-20);
  }

  .service-card__subtitle {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .service-card__label {
    margin: 0 0 var(--s-8);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--earth);
    font-weight: var(--w-semibold);
  }

  .service-card__section ul {
    display: grid;
    gap: var(--s-8);
    margin: 0;
    padding-left: 1.1rem;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
