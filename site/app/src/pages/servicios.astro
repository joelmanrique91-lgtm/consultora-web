---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout>
  <main>
    <h1>{site.brand.tagline}</h1>
    <p>Consolidamos estrategia, planificación y acompañamiento para potenciar tu comunicación institucional.</p>

    <section>
      <h2>Servicios</h2>
      {site.services.map((service) => (
        <article>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <p>Cuándo conviene: {service.when}</p>
        </article>
      ))}
    </section>

    <section>
      <p>{site.cta.text}</p>
      <a href={site.cta.href}>{site.cta.text}</a>
    </section>
  </main>
</Layout>
