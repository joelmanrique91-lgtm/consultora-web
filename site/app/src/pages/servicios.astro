---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import { site } from '../data/site';
import { withBase } from '../utils/links';
---

<Layout>
  <section class="section">
    <div class="container stack-lg">
      <header class="reading stack">
        <h1>{site.brand.tagline}</h1>
        <p>
          Consolidamos estrategia, planificación y acompañamiento para potenciar tu comunicación
          institucional.
        </p>
      </header>

      <div class="stack-lg">
        <h2>Servicios</h2>
        <div class="services-grid cards-grid">
          {site.services.map((service) => (
            <article class="card service-card">
              <div class="service-card__icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                  <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="2" />
                  <path
                    d="M14 24.5l6.5 6.5L34 18"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
              <h3 class="card__title">{service.title}</h3>
              <p class="service-card__subtitle">{service.description}</p>
              <div class="service-card__section">
                <h4 class="service-card__label">Ideal para:</h4>
                <ul class="service-card__list">
                  {service.ideal.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div class="service-card__section">
                <h4 class="service-card__label">Cuándo conviene</h4>
                <ul class="service-card__list">
                  {service.whenItems.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>

      <CTASection
        title="¿Te identificás con alguno de estos escenarios?"
        text="Contanos tu necesidad y definimos el plan más adecuado para ordenar tu comunicación institucional."
        ctaHref={withBase(site.cta.href)}
      />
    </div>
  </section>
</Layout>

<style>
  .services-grid {
    align-items: stretch;
  }

  .service-card {
    display: grid;
    gap: var(--space-md);
  }

  .service-card__icon {
    width: 48px;
    height: 48px;
    color: var(--color-acento);
  }

  .service-card__icon svg {
    width: 100%;
    height: 100%;
  }

  .service-card__subtitle {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .service-card__label {
    margin: 0 0 var(--space-sm);
    font-size: 1rem;
    color: var(--color-primario);
    font-weight: 600;
  }

  .service-card__list {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-card__list li {
    position: relative;
    padding-left: 1.2rem;
  }

  .service-card__list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-acento);
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
