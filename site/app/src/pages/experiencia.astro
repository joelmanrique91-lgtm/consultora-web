---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import { withBase } from '../utils/links';
---

<Layout>
  <section class="section experience-section">
    <div class="container stack-lg">
      <header class="reading stack">
        <h1>Experiencia</h1>
        <!-- texto anterior: "Trabajamos en proyectos de comunicación institucional, marketing B2B y procesos de gestión que requieren claridad estratégica y ejecución ordenada. Estas son algunas de las formas en que acompañamos a las organizaciones." -->
        <p>
          Trabajamos en proyectos de comunicación institucional y marketing B2B que requieren
          claridad estratégica, prioridades definidas y ejecución ordenada. Estas son algunas de las
          formas en que acompañamos a las organizaciones.
        </p>
      </header>

      <section class="stack-lg experience-cases">
        <header class="reading stack">
          <h2>Micro-casos (anónimos)</h2>
        </header>
        <div class="experience-grid cards-grid">
          <article class="card">
            <h3 class="card__title">Empresa industrial con expansión regional</h3>
            <p>Problema: cada área comunicaba con criterios distintos y había mensajes contradictorios.</p>
            <p>Intervención: diagnóstico, definición de mensajes clave y plan operativo compartido.</p>
            <p>Resultado: mayor coherencia interna y decisiones comunicadas con un mismo marco.</p>
          </article>
          <article class="card">
            <h3 class="card__title">Servicios B2B con múltiples voceros técnicos</h3>
            <p>Problema: falta de síntesis y pérdida de foco en presentaciones comerciales.</p>
            <p>Intervención: estructura narrativa, guiones y criterios de validación interna.</p>
            <p>Resultado: presentaciones más claras y procesos de aprobación simplificados.</p>
          </article>
          <article class="card">
            <h3 class="card__title">Operación logística con cambios internos</h3>
            <p>Problema: comunicación interna fragmentada durante un proceso de reorganización.</p>
            <p>Intervención: plan de comunicación, tablero de hitos y acompañamiento a líderes.</p>
            <p>Resultado: mensajes consistentes y mejor coordinación entre equipos.</p>
          </article>
        </div>
      </section>

      <section class="stack-lg experience-results experience-results--grouped">
        <header class="reading stack">
          <h2>Resultados y sectores</h2>
        </header>
        <div class="experience-duo">
          <div class="experience-duo__block">
            <h3 class="experience-subtitle">Resultados típicos</h3>
            <div class="results-grid">
              <article class="card result-card">
                <span class="result-card__icon" aria-hidden="true">✓</span>
                <p>Mayor claridad entre áreas.</p>
              </article>
              <article class="card result-card">
                <span class="result-card__icon" aria-hidden="true">✓</span>
                <p>Menos retrabajo.</p>
              </article>
              <article class="card result-card">
                <span class="result-card__icon" aria-hidden="true">✓</span>
                <p>Discursos alineados.</p>
              </article>
            </div>
          </div>
          <div class="experience-duo__block experience-duo__block--divider">
            <h3 class="experience-subtitle">Sectores</h3>
            <div class="tags">
              <span class="tag tag--chip">Minería</span>
              <span class="tag tag--chip">Servicios industriales</span>
              <span class="tag tag--chip">Energía</span>
              <span class="tag tag--chip">Industria manufacturera</span>
              <span class="tag tag--chip">Logística</span>
              <span class="tag tag--chip">PYMES B2B</span>
              <span class="tag tag--chip">Operación territorial</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>

  <section class="section experience-section">
    <div class="container stack-lg">
      <div class="reading stack">
        <h2>Tipos de proyectos</h2>
      </div>
      <div class="experience-grid cards-grid">
        <article class="card">
          <h3 class="card__title">Diagnósticos de comunicación interna y externa</h3>
          <p>Relevamos mensajes, públicos y puntos críticos para ordenar prioridades.</p>
        </article>
        <article class="card">
          <h3 class="card__title">Planes integrales de comunicación institucional</h3>
          <p>Definimos objetivos, tácticas y métricas con responsables claros.</p>
        </article>
        <article class="card">
          <h3 class="card__title">Identidad verbal y lineamientos de marca</h3>
          <p>Claridad en tono, mensajes clave y criterios de comunicación.</p>
        </article>
        <article class="card">
          <h3 class="card__title">Campañas informativas y materiales de soporte</h3>
          <p>Diseño de piezas con foco en coherencia y continuidad.</p>
        </article>
        <article class="card">
          <h3 class="card__title">Acompañamiento en procesos de cambio organizacional</h3>
          <p>Orden y seguimiento en proyectos sensibles.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section experience-section experience-section--alt">
    <div class="container stack-lg">
      <div class="reading stack">
        <h2>Qué resolvemos típicamente</h2>
      </div>
      <ul class="experience-list">
        <li>Mensajes clave y públicos prioritarios sin definición común.</li>
        <li>Acciones, responsables y cronograma sin orden operativo.</li>
        <li>Inconsistencias entre lo que se comunica y lo que se implementa.</li>
        <li>Procesos internos sin lineamientos de comunicación compartidos.</li>
        <li>Necesidad de acompañamiento durante cambios sensibles.</li>
      </ul>
    </div>
  </section>

  <section class="section experience-section">
    <div class="container stack-lg">
      <div class="reading stack">
        <h2>Entregables habituales</h2>
      </div>
      <div class="experience-grid cards-grid">
        <article class="card">
          <h3 class="card__title">Diagnóstico con hallazgos, riesgos y oportunidades</h3>
        </article>
        <article class="card">
          <h3 class="card__title">Plan de comunicación con objetivos, tácticas y métricas</h3>
        </article>
        <article class="card">
          <h3 class="card__title">Guías de tono, mensajes clave y criterios de comunicación</h3>
        </article>
        <article class="card">
          <h3 class="card__title">Tablero de seguimiento con hitos y responsables</h3>
        </article>
        <article class="card">
          <h3 class="card__title">Materiales institucionales y kits de comunicación interna</h3>
        </article>
      </div>
    </div>
  </section>

  <section class="section experience-section">
    <div class="container">
      <CTASection
        title="Conversemos sobre tu proyecto"
        text="Podemos ayudarte a ordenar la comunicación y avanzar con claridad."
        ctaHref={withBase('/contacto')}
        class="experience-cta"
      />
    </div>
  </section>
</Layout>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .experience-section--alt {
    background: var(--earth-soft);
  }

  .experience-cases .card {
    gap: var(--s-8);
  }

  .experience-cases p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .tag--chip {
    background: rgba(106, 168, 58, 0.12);
    border: 1px solid rgba(106, 168, 58, 0.4);
    color: var(--earth);
    font-weight: var(--w-semibold);
    font-size: 0.78rem;
    padding: 6px 14px;
  }

  .results-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .experience-duo {
    display: grid;
    gap: var(--space-lg);
  }

  .experience-duo__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .experience-duo__block--divider {
    padding-top: var(--space-md);
    border-top: 1px solid rgba(106, 168, 58, 0.2);
  }

  .experience-subtitle {
    margin: 0;
    font-size: 1.1rem;
    color: var(--earth);
  }

  .result-card {
    display: flex;
    gap: var(--s-12);
    align-items: flex-start;
  }

  .result-card__icon {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-soft);
    color: var(--earth);
    font-weight: var(--w-semibold);
  }

  .result-card p {
    margin: 0;
    font-weight: var(--w-medium);
  }

  .experience-grid {
    gap: var(--space-md);
    align-items: stretch;
  }

  .experience-grid .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-12);
  }

  .experience-grid p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .experience-list {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: var(--s-12);
  }

  .experience-cta {
    background: #f6efdd;
  }

  @media (min-width: 768px) {
    .experience-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .experience-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .experience-grid .card {
      min-height: 220px;
    }
  }

  @media (min-width: 900px) {
    .experience-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .experience-duo {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl);
    }

    .experience-duo__block--divider {
      padding-top: 0;
      padding-left: var(--space-lg);
      border-top: 0;
      border-left: 1px solid rgba(106, 168, 58, 0.2);
    }
  }
</style>
