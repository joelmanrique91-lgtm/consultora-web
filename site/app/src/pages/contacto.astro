---
import Layout from '../layouts/Layout.astro';
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;
---

<Layout>
  <section class="section">
    <div class="container stack-lg">
      <header class="reading stack">
        <h1>Contacto</h1>
        <p>Escribinos y coordinamos una llamada.</p>
      </header>

      <section class="reading info-block">
        <div>
          <h2>Qué pasa después</h2>
          <div class="info-grid">
            <div>
              <p class="info-label">Tiempo de respuesta</p>
              <p>Te respondemos a la brevedad en días hábiles.</p>
            </div>
            <div>
              <p class="info-label">Qué info pedimos y por qué</p>
              <p>Nos ayuda a entender el contexto y preparar una conversación productiva.</p>
            </div>
            <div>
              <p class="info-label">Cómo es la primera reunión</p>
              <p>Una llamada de 20 a 30 minutos para alinear objetivos y próximos pasos.</p>
            </div>
          </div>
        </div>
      </section>

      <form
        class="contact-form card"
        id="contact-form"
        method="POST"
        action={contactEndpoint}
        data-endpoint={contactEndpoint}
      >
        <div class="contact-form__grid">
          <label class="contact-form__field">
            <span>Nombre y apellido *</span>
            <input class="form-control" type="text" name="name" required autocomplete="name" />
          </label>

          <label class="contact-form__field">
            <span>Empresa *</span>
            <input
              class="form-control"
              type="text"
              name="company"
              required
              autocomplete="organization"
            />
          </label>

          <label class="contact-form__field">
            <span>Email *</span>
            <input class="form-control" type="email" name="email" required autocomplete="email" />
          </label>

          <label class="contact-form__field">
            <span>Teléfono / WhatsApp</span>
            <input class="form-control" type="tel" name="phone" autocomplete="tel" />
          </label>

          <label class="contact-form__field">
            <span>Rubro</span>
            <select class="form-control" name="industry">
              <option value="">Seleccionar</option>
              <option value="industria">Industria</option>
              <option value="energia">Energía</option>
              <option value="servicios-b2b">Servicios B2B</option>
              <option value="organizaciones">Organizaciones</option>
              <option value="otros">Otros</option>
            </select>
          </label>

          <label class="contact-form__field">
            <span>¿Qué buscás resolver?</span>
            <select class="form-control" name="goal">
              <option value="">Seleccionar</option>
              <option value="ordenar-comunicacion">Ordenar la comunicación</option>
              <option value="definir-mensajes">Definir mensajes clave</option>
              <option value="planificar-acciones">Planificar acciones</option>
              <option value="acompanamiento-proyecto">Acompañamiento de proyecto</option>
            </select>
          </label>
        </div>

        <label class="contact-form__field contact-form__field--full">
          <span>Mensaje *</span>
          <textarea class="form-control" name="message" rows="5" required></textarea>
        </label>

        <label class="contact-form__honeypot">
          <span>Website</span>
          <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
        </label>

        <div class="contact-form__actions">
          <button class="btn-primary" type="submit">Coordinar primera conversación</button>
          <p class="contact-form__status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>
</Layout>

<style>
  .info-block {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(20px, 2vw, 28px);
    background: var(--surface);
  }

  .info-grid {
    display: grid;
    gap: var(--s-16);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .info-label {
    margin: 0 0 var(--s-8);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--earth);
    font-weight: var(--w-semibold);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg);
    max-width: 600px;
    margin-inline: auto;
    align-items: stretch;
    margin-bottom: var(--s-32);
  }

  .contact-form__grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
    font-weight: var(--w-semibold);
    color: var(--text);
  }

  .contact-form__field span {
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .form-control {
    font: inherit;
    padding: 12px 14px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #ffffff;
  }

  .form-control:focus {
    outline: 2px solid rgba(146, 192, 100, 0.4);
    outline-offset: 2px;
    border-color: var(--accent);
  }

  select.form-control {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--accent) 50%),
      linear-gradient(135deg, var(--accent) 50%, transparent 50%);
    background-position: calc(100% - 18px) calc(50% - 4px),
      calc(100% - 12px) calc(50% - 4px);
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
    padding-right: 42px;
  }

  .contact-form textarea.form-control {
    min-height: 140px;
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  .contact-form__actions {
    display: flex;
    flex-direction: column;
    gap: var(--s-12);
    align-items: stretch;
  }

  .contact-form__actions .btn-primary {
    width: 100%;
  }

  .contact-form__status {
    margin: 0;
    font-size: var(--text-small);
    color: var(--earth);
  }

  .contact-form__status.is-error {
    color: var(--color-alerta);
  }

  .contact-form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .contact-form {
      padding: var(--space-md);
    }
  }

  @media (min-width: 768px) {
    .contact-form__actions {
      flex-direction: row;
      justify-content: flex-end;
      align-items: center;
    }

    .contact-form__actions .btn-primary {
      width: auto;
    }
  }
</style>

<script>
  const form = document.querySelector('#contact-form');
  const status = document.querySelector('.contact-form__status');

  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      status.classList.remove('is-error');

      const honeypot = form.querySelector('input[name="company_website"]');
      if (honeypot && honeypot.value) {
        status.textContent = 'No se pudo enviar el mensaje.';
        status.classList.add('is-error');
        return;
      }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        status.textContent = 'No se pudo enviar el mensaje. Intentá nuevamente más tarde.';
        status.classList.add('is-error');
        return;
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });

        if (response.ok) {
          form.reset();
          status.textContent = 'Mensaje enviado. Gracias por contactarnos.';
        } else {
          status.textContent = 'No se pudo enviar el mensaje. Intentá nuevamente.';
          status.classList.add('is-error');
        }
      } catch (error) {
        status.textContent = 'No se pudo enviar el mensaje. Intentá nuevamente.';
        status.classList.add('is-error');
      }
    });
  }
</script>
