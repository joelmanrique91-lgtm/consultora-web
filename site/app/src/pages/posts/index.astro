---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const formatter = new Intl.DateTimeFormat('es-AR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Layout>
  <section class="section">
    <div class="container stack-lg">
      <header class="reading stack">
        <h1>Posts</h1>
        <p>
          Recursos breves para ordenar la comunicación institucional y fortalecer el posicionamiento
          de tu empresa.
        </p>
      </header>

      <section class="posts-grid cards-grid">
        {posts.map((post) => (
          <article class="card-post card">
            <div class="post-card__image" aria-hidden="true"></div>
            <div class="post-card__meta small">
              <span>{formatter.format(post.data.date)}</span>
            </div>
            <h3 class="post-card__title">{post.data.title}</h3>
            <p class="post-card__description">{post.data.description}</p>
            <div class="post-card__tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <a class="btn-secondary post-card__cta" href={`/posts/${post.slug}`}>
              Leer el artículo
            </a>
          </article>
        ))}
      </section>
    </div>
  </section>
</Layout>

<style>
  .posts-grid {
    align-items: stretch;
  }

  .card-post {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .post-card__meta {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .post-card__description {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
  }

  .post-card__title {
    margin: 0;
    font-weight: 700;
  }

  .post-card__cta {
    align-self: flex-start;
  }

  .post-card__image {
    width: 100%;
    height: 160px;
    border-radius: var(--radius);
    background: #e4e4e4;
  }
</style>
