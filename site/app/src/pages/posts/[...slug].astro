---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/CTASection.astro';
import Callout from '../../components/Callout.astro';
import { site } from '../../data/site';
import { normalizeInternalPath, withBase } from '../../utils/links';
import { getCollection } from 'astro:content';
import { getPostSlug } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const formatter = new Intl.DateTimeFormat('es-AR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Layout>
  <section class="section">
    <div class="container stack-lg">
      <header class="post-header reading stack">
        <p class="post-date small">{formatter.format(post.data.date)}</p>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </header>

      <div class="reading stack-lg">
        <div>
          <p class="idea-label small">Idea clave</p>
          <Callout text={post.data.idea} />
        </div>

        <article class="post-content">
          <Content />
        </article>

        <section class="post-takeaways">
          <h2>Takeaways</h2>
          <ul>
            {post.data.takeaways.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      </div>

      <CTASection
        title="Acción recomendada"
        text="Si querés revisar tus mensajes clave y ordenar prioridades, coordinemos una reunión."
        ctaHref={withBase(normalizeInternalPath(site.cta.href))}
      />
    </div>
  </section>
</Layout>

<style>
  .post-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--s-24);
    gap: var(--s-12);
  }

  .post-description {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
  }

  .post-date {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .idea-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--s-8);
  }

  .post-content :global(h2) {
    margin-top: var(--s-32);
    color: var(--earth);
  }

  .post-content :global(p) {
    color: var(--text);
    line-height: 1.7;
  }

  .post-content :global(ul) {
    margin-top: var(--s-16);
    padding-left: 1.2rem;
  }

  .post-content :global(h3) {
    margin-top: var(--s-24);
    color: var(--text);
  }

  .post-content :global(img) {
    margin: var(--s-24) 0;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: 0 12px 24px rgba(47, 47, 47, 0.08);
  }

  .post-content :global(blockquote) {
    margin: var(--s-24) 0;
    padding: var(--s-20);
    border-left: 4px solid var(--accent);
    background: var(--earth-soft);
    border-radius: var(--radius);
    color: var(--earth);
  }

  .post-takeaways ul {
    display: grid;
    gap: var(--s-8);
    margin: 0;
    padding-left: 1.1rem;
  }
</style>
