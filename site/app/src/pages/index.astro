---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Callout from '../components/Callout.astro';
import Stepper from '../components/Stepper.astro';
import Cards from '../components/Cards.astro';
import CTASection from '../components/CTASection.astro';
import pistachoCombined from '../assets/brand/pistacho_combined.jpg';
import seal from '../assets/brand/seal.svg';
import { withBase } from '../utils/links';

const workflowSteps = [
  {
    num: '01',
    title: 'Diagnóstico',
    desc: 'Relevamos objetivos, actores y puntos críticos internos y externos. Resultado: un mapa claro de situación para decidir con evidencia.',
  },
  {
    num: '02',
    title: 'Estrategia',
    desc: 'Definimos enfoque, audiencias y mensajes clave compartidos. Resultado: una narrativa institucional coherente y aplicable por todo el equipo.',
  },
  {
    num: '03',
    title: 'Plan de acción',
    desc: 'Convertimos la estrategia en prioridades, responsables y tiempos. Resultado: un plan operativo que ordena esfuerzos y evita dispersión.',
  },
  {
    num: '04',
    title: 'Implementación y acompañamiento',
    desc: 'Acompañamos la ejecución para sostener consistencia y coordinación interna. Resultado: comunicación alineada en la práctica, no solo en el papel.',
  },
  {
    num: '05',
    title: 'Medición y ajuste',
    desc: 'Revisamos avances, identificamos desvíos y ajustamos criterios. Resultado: continuidad y mejora sostenida del sistema comunicacional.',
  },
];

const deliverables = [
  {
    title: 'Diagnóstico institucional (PDF)',
    subtitle: 'Documento base con hallazgos, riesgos y oportunidades.',
    items: ['Valor: permite decidir con claridad qué ordenar primero.'],
  },
  {
    title: 'Mensajes clave',
    subtitle: 'Lineamientos de narrativa institucional para uso interno y externo.',
    items: ['Valor: reduce contradicciones y unifica la voz de la organización.'],
  },
  {
    title: 'Plan estratégico trimestral',
    subtitle: 'Hoja de ruta con objetivos, prioridades y métricas.',
    items: ['Valor: ordena recursos y evita la improvisación.'],
  },
  {
    title: 'Calendario editorial',
    subtitle: 'Planificación mensual con responsables y criterios editoriales.',
    items: ['Valor: asegura continuidad y coherencia en cada comunicación.'],
  },
  {
    title: 'Guiones / piezas institucionales',
    subtitle: 'Guías para presentaciones, comunicados y materiales clave.',
    items: ['Valor: mejora la calidad y consistencia de los mensajes críticos.'],
  },
  {
    title: 'Reportes mensuales',
    subtitle: 'Síntesis de avances, aprendizajes y próximos pasos.',
    items: ['Valor: facilita la toma de decisiones y el seguimiento real.'],
  },
];
---

<Layout>
  <!-- subtitle anterior: "Ayudamos a pymes industriales y empresas B2B a organizar su comunicación, definir mensajes claros y acompañar la implementación con criterio estratégico." -->
  <Hero
    title="Comunicación institucional para ordenar mensajes, decisiones y crecimiento."
    subtitle={`Cuando la estructura se expande, la comunicación se vuelve dispersa. Diseñamos un sistema común que alinea equipos, reduce contradicciones y sostiene una narrativa clara.`}
    ctaHref={withBase('/contacto')}
    ctaLabel="Coordinar una reunión de diagnóstico."
    secondaryCtaHref={withBase('/servicios')}
    secondaryCtaLabel="Conocer el enfoque."
    backgroundSrc={pistachoCombined}
    backgroundAlt="Fondo abstracto con sello institucional"
  />

  <section class="section section--alt">
    <div class="container stack-lg">
      <div class="home-intro">
        <div class="home-intro__callout">
          <Callout
            text="Cuando la empresa crece, los mensajes se multiplican y el riesgo de incoherencia aumenta."
          />
        </div>
        <div class="home-intro__text stack">
          <h2>Comunicación desordenada: síntomas que frenan el crecimiento.</h2>
          <p>
            ¿Cada área comunica con criterios distintos? ¿Los mensajes cambian según quién los
            diga? Esto suele pasar cuando el crecimiento avanza sin un marco institucional
            compartido.
          </p>
          <p>
            La falta de orden genera retrabajo, desgaste interno y pérdida de claridad ante
            clientes y aliados. Lo que debería fortalecer la reputación termina debilitándola.
          </p>
          <p>
            Nuestro trabajo crea un marco común: prioridades claras, mensajes alineados y un ritmo
            de comunicación sostenible.
          </p>
          <a class="btn-link" href={withBase('/servicios')}>
            Conversar sobre el estado actual de tu comunicación.
          </a>
        </div>
      </div>
      <div class="section-cta cta-panel">
        <a class="btn-primary" href={withBase('/contacto')}>
          Conversar sobre el estado actual de tu comunicación.
        </a>
        <p class="cta-note">
          En una reunión breve analizamos el contexto y definimos si este enfoque es el adecuado
          para tu organización.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container stack-lg">
      <div class="reading stack">
        <h2>Método</h2>
        <p>
          Un proceso profesional, con etapas claras y resultados verificables.
        </p>
      </div>
      <div class="method-layout">
        <div class="method-seal">
          <img src={seal.src} alt="Sello de enfoque institucional" width="120" height="120" />
          <p>Sello metodológico: orden, claridad y seguimiento.</p>
        </div>
        <Stepper items={workflowSteps} class="method-steps" />
      </div>
      <div class="method-proof">
        <div class="method-proof__block">
          <h3>Sectores donde trabajamos</h3>
          <ul>
            <li>Industrial y manufactura.</li>
            <li>Servicios B2B.</li>
            <li>Energía, logística y operación territorial.</li>
          </ul>
        </div>
        <div class="method-proof__block">
          <h3>Resultados típicos</h3>
          <ul>
            <li>Mensajes unificados entre áreas.</li>
            <li>Menos retrabajo.</li>
            <li>Decisiones más seguras.</li>
          </ul>
        </div>
        <div class="method-proof__block">
          <h3>Entregables estratégicos</h3>
          <ul>
            <li>Diagnóstico institucional.</li>
            <li>Lineamientos de mensajes.</li>
            <li>Plan de acción y seguimiento.</li>
          </ul>
        </div>
      </div>
      <div class="section-cta cta-panel">
        <a class="btn-primary" href={withBase('/contacto')}>Coordinar una reunión de diagnóstico.</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container stack-lg">
      <div class="reading stack">
        <h2>Entregables</h2>
        <p>
          Materiales concretos para sostener la estrategia, alinear equipos y dar continuidad a la
          comunicación institucional.
        </p>
      </div>
      <Cards items={deliverables} class="cards--compact" />
      <div class="section-cta cta-panel">
        <a class="btn-primary" href={withBase('/contacto')}>Coordinar una reunión de diagnóstico.</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack-lg">
      <div class="reading stack">
        <h2>Para quién / Para quién no</h2>
        <p>
          Trabajamos con equipos que buscan orden, criterio y continuidad.
        </p>
      </div>
      <div class="fit-grid cards-grid">
        <article class="card fit-card fit-card--positive">
          <div class="fit-card__head">
            <span class="fit-card__icon" aria-hidden="true">✓</span>
            <h3 class="card__title">Para quién</h3>
          </div>
          <ul>
            <li>Empresas B2B que necesitan alinear su comunicación institucional.</li>
            <li>Organizaciones con múltiples áreas y voceros que requieren un marco común.</li>
            <li>Direcciones que quieren una hoja de ruta clara y seguimiento real.</li>
          </ul>
        </article>
        <article class="card fit-card fit-card--negative">
          <div class="fit-card__head">
            <span class="fit-card__icon" aria-hidden="true">×</span>
            <h3 class="card__title">Para quién no</h3>
          </div>
          <ul>
            <li>Proyectos aislados sin diagnóstico ni planificación.</li>
            <li>Equipos que no pueden involucrarse en la alineación interna.</li>
            <li>Pedidos urgentes sin objetivos compartidos.</li>
          </ul>
        </article>
      </div>
      <CTASection
        title="La claridad permite decidir con criterio."
        text="Si tu comunicación hoy es dispersa, conversemos para evaluar un enfoque que ordene mensajes, equipos y prioridades."
        ctaHref={withBase('/contacto')}
        ctaLabel="Coordinar una reunión de diagnóstico."
        class="home-cta"
      />
    </div>
  </section>
</Layout>

<style>
  .home-intro {
    display: grid;
    gap: var(--space-md);
    align-items: start;
    grid-template-columns: minmax(0, 1fr);
  }

  .home-intro__callout,
  .home-intro__text {
    max-width: 540px;
  }

  .home-intro__callout {
    opacity: 0.85;
  }

  .method-layout {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
    grid-template-columns: minmax(0, 1fr);
  }

  .fit-grid {
    align-items: stretch;
  }

  .fit-card {
    gap: var(--s-16);
  }

  .fit-card__head {
    display: flex;
    align-items: flex-start;
    gap: var(--s-12);
  }

  .fit-card__icon {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 2px 6px rgba(47, 47, 47, 0.12);
  }

  .fit-card .card__title {
    margin: 0;
  }

  .fit-card--positive {
    background: #e8f4da;
  }

  .fit-card--negative {
    background: #f3e6dc;
  }

  .method-seal {
    display: flex;
    align-items: flex-start;
    gap: var(--s-12);
    padding: var(--s-12) 0 var(--s-12) var(--s-16);
    border-left: 2px solid rgba(136, 115, 85, 0.35);
    background: transparent;
    color: var(--muted);
  }

  .method-seal img {
    width: 80px;
    height: 80px;
    opacity: 0.8;
  }

  .method-seal p {
    margin: 0;
    font-weight: 400;
    line-height: 1.5;
  }

  .home-cta {
    background: #f6efdd;
  }

  .cta-note {
    margin: var(--s-12) 0 0;
    color: var(--muted);
    font-size: var(--text-small);
  }

  .method-proof {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }

  .method-proof__block {
    border-left: 2px solid rgba(136, 115, 85, 0.2);
    padding-left: var(--s-16);
  }

  .method-proof__block h3 {
    margin: 0 0 var(--s-8);
    font-size: 1rem;
    color: var(--earth);
  }

  .method-proof__block ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    display: grid;
    gap: var(--s-8);
  }

  @media (min-width: 900px) {
    .home-intro {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-lg);
    }

    .method-layout {
      grid-template-columns: minmax(0, 0.4fr) minmax(0, 1fr);
    }

    .method-steps {
      align-self: stretch;
    }

    .method-proof {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
