---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Callout from '../components/Callout.astro';
import Stepper from '../components/Stepper.astro';
import Cards from '../components/Cards.astro';
import CTASection from '../components/CTASection.astro';
import heroBackground from '../assets/brand/hero-background.svg';
import seal from '../assets/brand/seal.svg';

const workflowSteps = [
  {
    num: '01',
    title: 'Diagnóstico',
    desc: 'Relevamos el contexto institucional, objetivos y puntos críticos para ordenar prioridades.',
  },
  {
    num: '02',
    title: 'Estrategia',
    desc: 'Definimos enfoque, audiencias y mensajes clave para una comunicación consistente.',
  },
  {
    num: '03',
    title: 'Plan de acción',
    desc: 'Traducimos la estrategia en un plan concreto con responsables, tiempos y hitos.',
  },
  {
    num: '04',
    title: 'Implementación y acompañamiento',
    desc: 'Trabajamos junto al equipo interno para ejecutar con claridad y seguimiento.',
  },
  {
    num: '05',
    title: 'Medición y ajuste',
    desc: 'Monitoreamos avances, detectamos desvíos y ajustamos para sostener resultados.',
  },
];

const deliverables = [
  {
    title: 'Diagnóstico institucional (PDF)',
    subtitle: 'Documento base con hallazgos, mapa de situación y oportunidades de mejora.',
    items: ['Hallazgos clave', 'Mapa de situación', 'Oportunidades de mejora'],
  },
  {
    title: 'Mensajes clave',
    subtitle: 'Lineamientos de narrativa institucional para comunicación interna y externa.',
    items: ['Narrativa institucional', 'Consistencia interna', 'Coherencia externa'],
  },
  {
    title: 'Plan estratégico trimestral',
    subtitle: 'Hoja de ruta con objetivos, prioridades y métricas de seguimiento.',
    items: ['Objetivos claros', 'Prioridades compartidas', 'Métricas de seguimiento'],
  },
  {
    title: 'Calendario editorial',
    subtitle: 'Planificación mensual de contenidos y responsables para sostener continuidad.',
    items: ['Planificación mensual', 'Roles definidos', 'Continuidad narrativa'],
  },
  {
    title: 'Guiones / piezas institucionales',
    subtitle: 'Guías para presentaciones, comunicados y materiales institucionales.',
    items: ['Presentaciones claras', 'Comunicados consistentes', 'Materiales institucionales'],
  },
  {
    title: 'Reportes mensuales',
    subtitle: 'Resumen de avances, aprendizajes y próximos pasos para la toma de decisiones.',
    items: ['Avances reales', 'Aprendizajes', 'Próximos pasos'],
  },
];
---

<Layout>
  <Hero
    title="Comunicación institucional estratégica para empresas que necesitan orden y claridad"
    subtitle="Ayudamos a pymes industriales y empresas B2B a organizar su comunicación, definir mensajes claros y acompañar la implementación con criterio estratégico."
    ctaHref="/contacto"
    backgroundSrc={heroBackground}
    backgroundAlt="Fondo abstracto con sello institucional"
  />

  <section class="section section--alt">
    <div class="container stack-lg">
      <div class="home-intro">
        <div class="home-intro__callout">
          <Callout
            text="Cuando una empresa crece, la comunicación también tiene que crecer: más áreas, más públicos, más riesgo de incoherencia."
          />
        </div>
        <div class="home-intro__text stack">
          <h2>Problema típico en pymes B2B</h2>
          <p>
            Con el crecimiento aparecen más áreas, más voceros y más mensajes en juego. Sin un
            sistema común, cada equipo comunica con sus propios criterios y se pierden foco y
            coherencia.
          </p>
          <p>
            El resultado suele ser retrabajo, discursos que no se alinean entre sí y oportunidades
            que se diluyen por falta de claridad institucional.
          </p>
          <p>
            Nuestro trabajo ordena prioridades, alinea mensajes y establece un ritmo de comunicación
            sostenido para decisiones más seguras.
          </p>
          <a class="btn-link" href="/servicios">Ver servicios</a>
        </div>
      </div>
      <div class="section-cta cta-panel">
        <a class="btn-primary" href="/contacto">Coordinar una reunión</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container stack-lg">
      <div class="reading stack">
        <h2>Método</h2>
        <p>
          Proponemos un proceso claro, con foco en orden, coordinación interna y acompañamiento
          sostenido.
        </p>
      </div>
      <div class="method-layout">
        <div class="method-seal">
          <img src={seal} alt="Sello de enfoque institucional" width="120" height="120" />
          <p>Sello metodológico: orden, claridad y seguimiento.</p>
        </div>
        <Stepper items={workflowSteps} class="method-steps" />
      </div>
      <div class="section-cta cta-panel">
        <a class="btn-primary" href="/contacto">Coordinar una reunión</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container stack-lg">
      <div class="reading stack">
        <h2>Entregables</h2>
        <p>
          Documentación y materiales concretos para sostener la estrategia en el tiempo, con foco
          en la consistencia y la toma de decisiones.
        </p>
      </div>
      <Cards items={deliverables} class="cards--compact" />
      <div class="section-cta cta-panel">
        <a class="btn-primary" href="/contacto">Coordinar una reunión</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack-lg">
      <div class="reading stack">
        <h2>Para quién / Para quién no</h2>
        <p>
          Buscamos trabajar con equipos que valoran el orden, la planificación y la continuidad como
          base de la comunicación institucional.
        </p>
      </div>
      <div class="fit-grid cards-grid">
        <article class="card fit-card fit-card--positive">
          <div class="fit-card__head">
            <span class="fit-card__icon" aria-hidden="true">✓</span>
            <h3 class="card__title">Para quién</h3>
          </div>
          <ul>
            <li>Empresas B2B que necesitan ordenar su comunicación institucional.</li>
            <li>Equipos con múltiples áreas que requieren mensajes coherentes.</li>
            <li>Direcciones que buscan una hoja de ruta y seguimiento real.</li>
          </ul>
        </article>
        <article class="card fit-card fit-card--negative">
          <div class="fit-card__head">
            <span class="fit-card__icon" aria-hidden="true">×</span>
            <h3 class="card__title">Para quién no</h3>
          </div>
          <ul>
            <li>Organizaciones que buscan acciones aisladas sin planificación.</li>
            <li>Proyectos que no cuentan con tiempo para alinear equipos internos.</li>
            <li>Pedidos urgentes sin diagnóstico ni objetivos compartidos.</li>
          </ul>
        </article>
      </div>
      <CTASection
        title="Cuando haya claridad, el siguiente paso es decidir"
        text="Si buscás ordenar, fortalecer o desarrollar la comunicación de tu empresa, coordinemos una reunión para definir un plan claro."
        ctaHref="/contacto"
        class="home-cta"
      />
    </div>
  </section>
</Layout>

<style>
  .home-intro {
    display: grid;
    gap: var(--space-md);
    align-items: start;
  }

  .home-intro__callout,
  .home-intro__text {
    max-width: 540px;
  }

  .home-intro__callout {
    opacity: 0.85;
  }

  .method-layout {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .fit-grid {
    align-items: stretch;
  }

  .fit-card {
    gap: var(--s-16);
  }

  .fit-card__head {
    display: flex;
    align-items: flex-start;
    gap: var(--s-12);
  }

  .fit-card__icon {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 2px 6px rgba(47, 47, 47, 0.12);
  }

  .fit-card .card__title {
    margin: 0;
  }

  .fit-card--positive {
    background: #e8f4da;
  }

  .fit-card--negative {
    background: #f3e6dc;
  }

  .method-seal {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius);
    border: 1px dashed var(--earth-mid);
    background: #fcf9f3;
    color: var(--earth);
  }

  .method-seal img {
    width: 80px;
    height: 80px;
  }

  .method-seal p {
    margin: 0;
    font-weight: var(--w-medium);
  }

  .home-cta {
    background: #f6efdd;
  }

  @media (min-width: 900px) {
    .home-intro {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-lg);
    }

    .method-layout {
      grid-template-columns: minmax(0, 0.4fr) minmax(0, 1fr);
    }

    .method-steps {
      align-self: stretch;
    }
  }
</style>
